  "title": "DNS：互联网的通讯录",
  "summary": "跟着一次网页请求，看域名如何变成服务器能理解的地址。",
  "truthLadder": {
    "analogy": "DNS 像通讯录：你记住朋友的名字，通讯录替你找到电话号码。",
    "technical": "解析器按缓存、递归解析器、根与权威服务器的顺序查询，最终获得带有效期的资源记录。",
    "caveat": "通讯录类比会隐藏缓存层、委派、多个记录类型，以及 DNS 回答不等于建立网络连接。"
  },
  "scenes": [
    {
      "id": "ask",
      "title": "先问离你最近的记忆",
      "summary": "浏览器和操作系统先检查缓存，避免每次都从头查询。",
      "evidence": ["rfc1034"],
      "nodes": [
        {
          "id": "browser",
          "kind": "actor",
          "label": "浏览器",
          "detail": "请求 example.com 的地址",
          "evidence": ["analogy-phonebook"]
        },
        {
          "id": "cache",
          "kind": "store",
          "label": "本地缓存",
          "detail": "保存仍在有效期内的答案",
          "evidence": ["rfc1034"],
          "failure": {
            "impact": "需要发起完整的递归查询",
            "symptom": "首次打开页面更慢",
            "fallback": "向递归解析器查询"
          }
        }
      ],
      "edges": [
        {
          "id": "ask-cache",
          "from": "browser",
          "to": "cache",
          "label": "有答案吗？"
        }
      ]
    },
    {
      "id": "resolve",
      "title": "沿着委派链找到负责人",
      "summary": "递归解析器替用户询问根、顶级域和权威服务器。",
      "nodes": [
        {
          "id": "resolver",
          "kind": "process",
          "label": "递归解析器",
          "detail": "协调查询并缓存结果",
          "evidence": ["rfc1034"],
          "failure": {
            "impact": "客户端无法获得新域名的地址",
            "symptom": "出现 DNS 解析超时",
            "fallback": "切换到另一台可信解析器"
          }
        },
        {
          "id": "root",
          "kind": "decision",
          "label": "根与顶级域",
          "detail": "指出下一位负责人",
          "evidence": ["rfc1034"]
        },
        {
          "id": "authoritative",
          "kind": "store",
          "label": "权威服务器",
          "detail": "给出域名的正式记录",
