  "glossary": [
    {
      "term": "解析器",
      "definition": "代表客户端查询 DNS，并把答案缓存一段时间的服务。"
    },
    {
      "term": "权威服务器",
      "definition": "对某个 DNS 区域持有正式记录的服务器。"
    },
    {
      "term": "TTL",
      "definition": "答案可以在缓存中保留的时间。"
    }
  ],
  "teachBack": [
    {
      "question": "为什么第二次打开同一网站通常不需要完整查询？",
      "answer": "因为浏览器、操作系统或递归解析器可能仍缓存着未过期的答案。"
    },
    {
      "question": "DNS 返回 IP 地址后，网页内容已经到达了吗？",
      "answer": "没有。DNS 只完成寻址，浏览器还要建立连接并发送应用层请求。"
    }
  ],
